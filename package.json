{
  "name": "drizzle-wallet-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seeds/system-accounts.seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.18",
    "hono-rate-limiter": "^0.5.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
