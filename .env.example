# App Configuration
PORT=8000
NODE_ENV=development

# Database Credentials (digunakan oleh Docker Compose & Koneksi Lokal)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wallet_db
DB_PORT=5432
DB_REPLICA1_PORT=5433
DB_REPLICA2_PORT=5434

# Replication Credentials (digunakan oleh Docker Compose)
DB_REPL_USER=repl_user
DB_REPL_PASSWORD=repl_password

# Database URLs (Primary untuk Write, Replicas untuk Read)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_db
DATABASE_READ_URL_1=postgresql://postgres:postgres@localhost:5433/wallet_db
DATABASE_READ_URL_2=postgresql://postgres:postgres@localhost:5434/wallet_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=3600
